{
  "name": "ttd-notula-bhp",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // KV untuk menyimpan notula, tanda tangan, dan koreksi.
  // Tanpa "id": wrangler memakai binding TTD yang sudah ada di Worker, atau membuatnya otomatis saat deploy.
  "kv_namespaces": [{ "binding": "TTD" }]
}
